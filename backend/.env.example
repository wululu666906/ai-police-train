# 必填：JWT 签名密钥（旧版 SECRET_KEY 仍兼容，建议统一用本项）
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 本地开发：sqlite:///ai_police.db
# Docker 单容器 / API 容器（docker-compose 会覆盖为 data 目录）：
DATABASE_URL=sqlite:///ai_police.db

CHROMA_DB_PATH=chroma_db

LLM_PROVIDER=qwen
EMBEDDING_PROVIDER=qwen

DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=

# 案件信息补全专员（案件录入/查看专用，默认走 DeepSeek）
CASE_COMPLETION_PROVIDER=deepseek
CASE_COMPLETION_MODEL=deepseek-chat

RAG_COLLECTION_NAME=legal_knowledge_qwen

# 科大讯飞 · 语音听写（流式版）
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_IAT_HOST=iat-api.xfyun.cn
IFLYTEK_IAT_PATH=/v2/iat
