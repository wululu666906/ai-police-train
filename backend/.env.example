# Backend settings
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Set to 1 only when intentionally creating local demo accounts. Never enable in production.
SEED_DEMO_ACCOUNTS=0
# Required only when initializing a brand-new database; use a unique password of at least 12 characters.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
CORS_ALLOW_ORIGINS=
FACE_ENGINE_WARMUP=0

# Storage
DATABASE_URL=sqlite:///../data/ai_police.db
CHROMA_DB_PATH=../data/chroma_db

# LLM and embedding providers
LLM_PROVIDER=qwen
EMBEDDING_PROVIDER=qwen
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
QWEN_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
QWEN_BASE_URL=
QWEN_CHAT_MODEL=qwen-plus
# Set these to provider models that explicitly support >= 20,000 completion tokens.
QWEN_LONG_OUTPUT_MODEL=qwen-plus
QWEN_MAX_OUTPUT_TOKENS=32768
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
## Default for all ordinary DeepSeek AI jobs (evaluation, question suggestions, imports, etc.).
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
## High-quality routes: evidence/case parsing/scene generation and live AI role acting.
DEEPSEEK_CASE_MODEL=deepseek-v4-pro
DEEPSEEK_ROLEPLAY_MODEL=deepseek-v4-pro
DEEPSEEK_LONG_OUTPUT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODE=disabled
DEEPSEEK_MAX_OUTPUT_TOKENS=128000
DEEPSEEK_EMBEDDING_MODEL=

# Local/intranet OpenAI-compatible chat model
# Set LLM_PROVIDER=custom to use these fields.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_CHAT_MODEL=
CUSTOM_LLM_LONG_OUTPUT_MODEL=
CUSTOM_LLM_MAX_OUTPUT_TOKENS=32768
LLM_PROFILES_JSON=[]

# Case evidence/worldview, scene blueprint and per-scene script output budget.
CASE_AI_MAX_TOKENS=128000
CASE_AI_EVIDENCE_MAX_TOKENS=1800
CASE_AI_STORY_MAX_TOKENS=2800
CASE_AI_WORLDVIEW_MAX_TOKENS=6000
CASE_AI_BLUEPRINT_MAX_TOKENS=2200
CASE_AI_SCRIPT_MAX_TOKENS=4000
CASE_AI_REPAIR_MAX_TOKENS=1600
CASE_AI_TEXT_SCENE_MAX_TOKENS=6000
CASE_AI_CHUNK_CHARS=48000
CASE_AI_CHUNK_OVERLAP=4000
CASE_AI_PARALLELISM=2
LLM_TIMEOUT_SECONDS=90
ROLE_DIRECTOR_USE_LLM=0
ROLE_DIRECTOR_MAX_TOKENS=320
ROLE_AI_MAX_TOKENS=700
ROLE_AI_USE_RAG=0

CASE_COMPLETION_PROVIDER=deepseek
CASE_COMPLETION_MODEL=deepseek-v4-pro

# Speech recognition (Qwen ASR - 千问语音识别)
# DASHSCOPE_API_KEY 同时用于 ASR 和 embedding（如果用千问 embedding）
QWEN_ASR_BASE_URL=
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_MAX_DATA_URL_BYTES=10485760
# 实时语音识别 WebSocket（视频实训期间流式 ASR）
QWEN_REALTIME_ASR_URL=
QWEN_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime

# RAG
RAG_COLLECTION_NAME=legal_knowledge_qwen
FALLBACK_EMBEDDING_DIMENSIONS=1024
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_CONTEXT_MAX_CHARS=3600
# Emergency offline recovery mode: keeps lexical retrieval available without
# sending knowledge documents to an embedding provider. Leave at 0 normally.
RAG_FORCE_LOCAL_FALLBACK=0

# Video import & AI analysis
# 视频分析流程：ffmpeg 提取音频 → 千问 ASR 转写 → 指定提供方生成训练点
# 默认使用同一个 DASHSCOPE_API_KEY；可改为 deepseek 并配置 DEEPSEEK_API_KEY。
# 需要：1) ffmpeg 已安装 2) DASHSCOPE_API_KEY（用于 ASR 和默认分析）
VIDEO_AUTO_IMPORT_DIR=
VIDEO_AUTO_ANALYZE=true
# 可选：本机 ffmpeg.exe 的完整路径；Docker 镜像内已自带 ffmpeg。
FFMPEG_BINARY=
VIDEO_ANALYSIS_PROVIDER=qwen
VIDEO_ANALYSIS_MODEL=qwen-plus
# ASR audio chunk size. Larger chunks reduce cloud API calls and are faster;
# keep within 10-60 seconds to preserve usable timestamp precision.
VIDEO_ASR_CHUNK_SECONDS=30

# Face verification persisted models
FACE_ENGINE_REQUIRED=1
INSIGHTFACE_MODEL_DIR=../data/face_models
INSIGHTFACE_MODEL_NAME=buffalo_l
FACE_IMAGE_DIR=backend/static/face_profiles
FACE_SIMILARITY_THRESHOLD=0.68
FACE_FAST_VERIFY_SIMILARITY_THRESHOLD=0.55
FACE_HEARTBEAT_SIMILARITY_THRESHOLD=0.68
FACE_MAX_FAILURES=5
FACE_SERIOUS_MAX_FAILURES=5
FACE_VOTE_WINDOW=3
FACE_VOTE_FAIL_LIMIT=2
FACE_CONSECUTIVE_MAX_FAILURES=5
