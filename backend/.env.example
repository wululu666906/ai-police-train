# Backend settings
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ALLOW_ORIGINS=
FACE_ENGINE_WARMUP=0

# Storage
DATABASE_URL=sqlite:///../data/ai_police.db
CHROMA_DB_PATH=../data/chroma_db

# LLM and embedding providers
LLM_PROVIDER=qwen
EMBEDDING_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
# Set these to provider models that explicitly support >= 20,000 completion tokens.
QWEN_LONG_OUTPUT_MODEL=qwen-plus
QWEN_MAX_OUTPUT_TOKENS=32768
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_LONG_OUTPUT_MODEL=deepseek-chat
DEEPSEEK_MAX_OUTPUT_TOKENS=128000
DEEPSEEK_EMBEDDING_MODEL=

# Case evidence/worldview, scene blueprint and per-scene script output budget.
CASE_AI_MAX_TOKENS=128000
CASE_AI_CHUNK_CHARS=120000
CASE_AI_CHUNK_OVERLAP=4000
LLM_TIMEOUT_SECONDS=300

CASE_COMPLETION_PROVIDER=deepseek
CASE_COMPLETION_MODEL=deepseek-chat

# Speech recognition (Qwen ASR - 千问语音识别)
# DASHSCOPE_API_KEY 同时用于 ASR 和 embedding（如果用千问 embedding）
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_MAX_DATA_URL_BYTES=10485760
# 实时语音识别 WebSocket（视频实训期间流式 ASR）
QWEN_REALTIME_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime

# RAG
RAG_COLLECTION_NAME=legal_knowledge_qwen
FALLBACK_EMBEDDING_DIMENSIONS=1024
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_CONTEXT_MAX_CHARS=3600

# Video import & AI analysis
# 视频分析流程：ffmpeg 提取音频 → 千问 ASR 转写 → 指定提供方生成训练点
# 默认使用同一个 DASHSCOPE_API_KEY；可改为 deepseek 并配置 DEEPSEEK_API_KEY。
# 需要：1) ffmpeg 已安装 2) DASHSCOPE_API_KEY（用于 ASR 和默认分析）
VIDEO_AUTO_IMPORT_DIR=
VIDEO_AUTO_ANALYZE=true
# 可选：本机 ffmpeg.exe 的完整路径；Docker 镜像内已自带 ffmpeg。
FFMPEG_BINARY=
VIDEO_ANALYSIS_PROVIDER=qwen
VIDEO_ANALYSIS_MODEL=qwen-plus

# Face verification persisted models
FACE_ENGINE_REQUIRED=1
INSIGHTFACE_MODEL_DIR=../data/face_models
INSIGHTFACE_MODEL_NAME=buffalo_l
FACE_IMAGE_DIR=backend/static/face_profiles
FACE_SIMILARITY_THRESHOLD=0.68
FACE_FAST_VERIFY_SIMILARITY_THRESHOLD=0.55
FACE_HEARTBEAT_SIMILARITY_THRESHOLD=0.68
FACE_MAX_FAILURES=5
FACE_SERIOUS_MAX_FAILURES=5
FACE_VOTE_WINDOW=3
FACE_VOTE_FAIL_LIMIT=2
FACE_CONSECUTIVE_MAX_FAILURES=5
