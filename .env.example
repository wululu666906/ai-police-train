# Docker Compose root settings
WEB_PORT=5555
APP_PORT=8000

DASHSCOPE_API_KEY=
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime

# Face verification persisted models
FACE_ENGINE_REQUIRED=1
INSIGHTFACE_MODEL_DIR=./data/face_models
INSIGHTFACE_MODEL_NAME=buffalo_l
FACE_LIVENESS_MODEL_PATH=./backend/assets/face_liveness_model.onnx
FACE_LIVENESS_VENDOR_MODEL_PATH=./vendor/face_antispoof_onnx_src/models/best/98.20/best_model_quantized.onnx
FACE_LIVENESS_MODEL_SIZE=128
FACE_LIVENESS_REAL_INDEX=0
FACE_LIVENESS_THRESHOLD=0.50
FACE_SIMILARITY_THRESHOLD=0.72
FACE_HEARTBEAT_SIMILARITY_THRESHOLD=0.68
FACE_MAX_FAILURES=5
