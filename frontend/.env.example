# 语音识别：auto | web | iflytek
# 推荐 auto：由后端 .env 管理科大讯飞密钥（勿把 APISecret 写进前端）
VITE_SPEECH_PROVIDER=auto
# 讯飞解析调试日志（仅本地开发）：1 开启 / 0 关闭
VITE_IFLYTEK_DEBUG=0
# 讯飞调试详细日志：包含时序与队列状态
VITE_IFLYTEK_DEBUG_VERBOSE=0

# 通话「说完自动发送」判停（毫秒，仅讯飞 voice_call 生效）
# - 停太短就发、句中被切断 → 调大（如 1800～2200）
# - 停太长才发、说完要等很久 → 调小（如 1200～1400）
# - 未配置时代码默认 1400；生产 .env.production 默认 1600
VITE_IFLYTEK_VAD_EOS=1600

# 科大讯飞密钥请配置在 backend/.env：
# IFLYTEK_APP_ID=
# IFLYTEK_API_KEY=
# IFLYTEK_API_SECRET=

# 可选：内网部署时指定本地 MediaPipe 资源路径，未配置则自动回退到在线 CDN
# VITE_MEDIAPIPE_TASKS_VISION_URL=/mediapipe/tasks-vision/index.js
# VITE_MEDIAPIPE_TASKS_VISION_WASM_URL=/mediapipe/tasks-vision/wasm
# VITE_MEDIAPIPE_POSE_MODEL_URL=/mediapipe/models/pose_landmarker_lite.task
