# Frontend settings
VITE_API_URL=/api

# Speech recognition: auto | qwen | web
# Recommended: auto. Qwen realtime ASR secrets stay in backend/.env.
VITE_SPEECH_PROVIDER=auto

# Optional local MediaPipe assets. Leave empty to use the default online fallback.
# VITE_MEDIAPIPE_TASKS_VISION_URL=/mediapipe/tasks-vision/index.js
# VITE_MEDIAPIPE_TASKS_VISION_WASM_URL=/mediapipe/tasks-vision/wasm
# VITE_MEDIAPIPE_POSE_MODEL_URL=/mediapipe/models/pose_landmarker_lite.task
